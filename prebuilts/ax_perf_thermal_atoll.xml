            <level id="1" min="825" max="825"/>
            <level id="2" min="800" max="800"/>
            <level id="3" min="650" max="650"/>
            <level id="4" min="565" max="565"/>
            <level id="5" min="430" max="430"/>
            <level id="6" min="355" max="355"/>
            <level id="7" min="267" max="267"/>
